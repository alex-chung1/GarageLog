# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_USER=garagelog_dev
POSTGRES_PASSWORD=localdevpass
POSTGRES_DB=garagelog

# Database Connection
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=garagelog;Username=garagelog_dev;Password=localdevpass;Include Error Detail=true

# Authentication
# Replace with a secure secret of at least 32 characters
JwtSettings__Secret=your-super-secret-key-that-is-at-least-32-characters